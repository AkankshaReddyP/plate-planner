rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(familyId) {
      return /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid);
    }

    function activeMember(familyId) {
      return signedIn()
        && exists(memberPath(familyId))
        && get(memberPath(familyId)).data.status == 'active'
        && get(memberPath(familyId)).data.role in ['admin', 'user'];
    }

    function isAdmin(familyId) {
      return activeMember(familyId)
        && get(memberPath(familyId)).data.role == 'admin';
    }

    // A newly authenticated account can only create its own default user record.
    // Admin elevation and all updates require a trusted server/admin process.
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'role', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Sensitive onboarding information is accessible only to the signed-in
    // account holder, not other registered users or family members.
    match /users/{uid}/private/onboarding {
      function ownProfile() {
        return signedIn() && request.auth.uid == uid;
      }
      function validProfile() {
        return request.resource.data.keys().hasOnly(['heightCm', 'weightKg', 'healthConditions', 'updatedAt'])
          && request.resource.data.keys().hasAll(['heightCm', 'weightKg', 'healthConditions', 'updatedAt'])
          && request.resource.data.heightCm is number
          && request.resource.data.heightCm >= 50
          && request.resource.data.heightCm <= 250
          && request.resource.data.weightKg is number
          && request.resource.data.weightKg >= 20
          && request.resource.data.weightKg <= 400
          && request.resource.data.healthConditions is list
          && request.resource.data.healthConditions.size() >= 1
          && request.resource.data.healthConditions.size() <= 7
          && request.resource.data.healthConditions.hasOnly(['Diabetes', 'High blood pressure', 'Arthritis', 'Thyroid condition', 'Other', 'None', 'Prefer not to share'])
          && (!(request.resource.data.healthConditions.hasAny(['None', 'Prefer not to share']))
              || request.resource.data.healthConditions.size() == 1)
          && request.resource.data.updatedAt == request.time;
      }
      allow get: if ownProfile();
      allow list: if false;
      allow create, update: if ownProfile() && validProfile();
      allow delete: if false;
    }

    match /foodCatalog/{foodId} {
      // Query callers must filter isActive == true. A rule is not a query filter.
      allow get, list: if signedIn() && resource.data.isActive == true;
      allow create, update, delete: if false;
    }

    match /families/{familyId} {
      allow get, list: if activeMember(familyId);
      allow create, update, delete: if false;

      match /members/{uid} {
        allow get, list: if activeMember(familyId)
          && (request.auth.uid == uid || isAdmin(familyId));
        allow create, update, delete: if false;
      }

      match /profiles/{profileId} {
        allow get, list: if activeMember(familyId);
        allow create, update, delete: if false;
      }
      match /targets/{targetId} {
        allow get, list: if activeMember(familyId);
        allow create, update, delete: if false;
      }
      match /mealPlans/{planId} {
        allow get, list: if activeMember(familyId);
        allow create, update, delete: if false;
      }
      match /mealLogs/{logId} {
        allow get, list: if activeMember(familyId);
        allow create, update, delete: if false;
      }
      match /measurements/{measurementId} {
        allow get, list: if activeMember(familyId);
        allow create, update, delete: if false;
      }
    }
    // Everything else is denied by default.
  }
}
